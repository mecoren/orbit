<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit 品牌色资源（M5.1）：启动屏底色（白底 + 居中品牌图） -->
<resources>
    <color name="launch_bg">#FFFFFFFF</color>
    <!-- 自适应图标背景层（mipmap-anydpi-v26/ic_launcher.xml 引用）：**白色底板**。
         2026-11-16 由透明（#00000000）改白：透明背景层在部分 ROM 的系统页
         （应用信息 / 最近任务 / 权限页）与启动器上被合成到**不透光黑底**，
         观感是「图标背景是黑的」；该合成按 alpha 判可见，改 #00FFFFFF 无效，
         唯一确定性消除办法就是给不透明底板。用户口径：宁要白底，不要黑底。
         同一资源亦被 values-v31 的 windowSplashScreenIconBackgroundColor 引用
         ——白圆底压在白启动屏上不可见，与「白底 + 居中品牌图」口径一致。 -->
    <color name="ic_launcher_background">#FFFFFFFF</color>
    <!-- 小组件（#3）：亮色卡片底 / 强调 / 勾选环，与移动端浅色主题对齐 -->
    <color name="widget_bg_color">#F2F3F7</color>
    <color name="widget_accent">#FF4E8CFF</color>
    <color name="widget_ring">#FF9CA3AF</color>
</resources>
