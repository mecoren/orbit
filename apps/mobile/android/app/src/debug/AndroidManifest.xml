<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 模拟器 Vulkan 驱动刷屏修复：Flutter 的 Impeller 后端在 Android 走
         Vulkan，模拟器 host GPU 直通（MESA）下每帧回收 fence 都会打出
         `E/MESA: Failed to find VkFence:0x...`，把 flutter run 日志刷满。
         仅在 debug/profile 构建关闭 Impeller、回落 Skia(OpenGL)；
         release 构建不含本文件，真机仍走 Impeller，渲染口径不受影响。 -->
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>

</manifest>
