<?xml version="1.0" encoding="utf-8"?>
<!-- Orbit 启动屏（API 31+ 深色模式）：与 values-v31 同内容——启动屏
     双主题共用白底（night 限定符优先于 version，故此处必须重复声明，
     否则深色模式下系统 SplashScreen 会回落黑底）。 -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
