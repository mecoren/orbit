# Rust（任意层级的 target/：根 workspace 与 apps/desktop/src-tauri 嵌套 workspace 各有构建目录）
target/
**/*.rs.bk

# Node / 前端
node_modules/
dist/

# Flutter / Dart（顶层通配：apps/mobile 等任意层级均覆盖）
.dart_tool/
build/

# Tauri 生成物（gen/ 整体随构建再生：桌面 schemas、历史遗留 Android 工程均已清除）
apps/desktop/src-tauri/gen/

# 数据库伴生文件（SQLite WAL/SHM）
*.sqlite-shm
*.sqlite-wal

# 日志与临时文件
*.log
*.pid
hs_err_pid*.log
replay_pid*.log
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml
.m4-evidence/
