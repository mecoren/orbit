{
  "name": "orbit-monorepo",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter orbit dev",
    "build": "pnpm --filter orbit build",
    "preview": "pnpm --filter orbit preview",
    "tauri": "pnpm --filter orbit tauri",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:rust": "cargo test --workspace",
    "fmt": "cargo fmt --all && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all",
    "fmt:check": "cargo fmt --all -- --check && cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --all -- --check",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "clippy:desktop": "cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:rust": "pnpm fmt:check && pnpm clippy && pnpm clippy:desktop",
    "lint": "pnpm typecheck && pnpm lint:rust"
  }
}
